+DownloadException InternetFailure(DWORD code)
+{
+    const char* description;
+    switch (code)
+    {
+        case ERROR_INTERNET_INVALID_CA:
+            description = "Untrusted TLS certificate authority";
+            break;
+        case ERROR_INTERNET_SEC_CERT_CN_INVALID:
+            description = "TLS certificate did not match the server name";
+            break;
+        case ERROR_INTERNET_SEC_CERT_DATE_INVALID:
+            description = "TLS certificate was outside its validity period";
+            break;
+        case ERROR_INTERNET_SEC_CERT_ERRORS:
+        case ERROR_INTERNET_SEC_INVALID_CERT:
+        case ERROR_INTERNET_SEC_CERT_REVOKED:
+        case ERROR_INTERNET_SEC_CERT_REV_FAILED:
+            description = "TLS certificate validation failed";
+            break;
+        case ERROR_INTERNET_SECURITY_CHANNEL_ERROR:
+            description = "TLS connection failed";
+            break;
+        default:
+            description = "WinINet request failed";
+            break;
+    }
+    return DownloadException(std::string(description) + " (WinINet " + std::to_string(code) + ").");
+}
+
 } // anonymous namespace
 
 
