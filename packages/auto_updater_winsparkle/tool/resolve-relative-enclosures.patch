+    InternetQueryOptionA(handle, INTERNET_OPTION_URL, NULL, &size);
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || size == 0)
+        return {};
+
+    DataBuffer<char> url(size);
