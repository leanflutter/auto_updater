+std::string ResolveDownloadURL(const std::string& base, const std::string& reference)
+{
+    // Preserve absolute URLs verbatim, including signed query parameters.
+    const auto delimiter = reference.find_first_of(":/?#");
+    if (delimiter != std::string::npos && reference[delimiter] == ':')
+        return reference;
+
+    constexpr DWORD flags = ICU_BROWSER_MODE;
+    DWORD size = 0;
+    InternetCombineUrlA(base.c_str(), reference.c_str(), NULL, &size, flags);
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || size == 0)
+        throw Win32Exception();
+
+    DataBuffer<char> result(size);
+    if (!InternetCombineUrlA(base.c_str(), reference.c_str(), result, &size, flags))
+        throw Win32Exception();
+
+    return std::string(result);
+}
